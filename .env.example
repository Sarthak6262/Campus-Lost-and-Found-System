# Environment Configuration
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/campus_lost_found

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production-minimum-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Admin Seed Configuration
ADMIN_EMAIL=admin@campusfind.com
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=System Administrator
ADMIN_STUDENT_ID=ADMIN001

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Application
APP_NAME=CampusFind
APP_VERSION=1.0.0
DEBUG=True

# Upload Configuration
UPLOAD_DIR=uploads/items
MAX_FILE_SIZE_MB=5
